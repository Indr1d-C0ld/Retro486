diff --git a/src/nvr_at.c b/src/nvr_at.c
index 3df3e5d35..c4a4db5b7 100644
--- a/src/nvr_at.c
+++ b/src/nvr_at.c
@@ -1174,16 +1174,22 @@ nvr_at_init(const device_t *info)
 
     nvr->data           = local;
 
+    /* Retro486 (wasm32): i parametri della NVR sono a 64 bit ma info->local e' un
+       puntatore; su un target a 32 bit si rileggono dalla tabella delle macchine. */
+    const uint64_t lp = (machines[machine].nvr_device &&
+                         ((uint32_t) machines[machine].nvr_params == (uint32_t) info->local)) ?
+                            (uint64_t) machines[machine].nvr_params : (uint64_t) info->local;
+
     /* This is machine specific. */
-    nvr->size           = (info->local & FLAG_FIXED_SIZE) ? 128 :
+    nvr->size           = (lp & FLAG_FIXED_SIZE) ? 128 :
                               (machines[machine].nvrmask + 1);
     local->lock         = (uint8_t *) calloc(1, nvr->size);
 
-    local->flags        = info->local & 0xffff;
-    local->cent         = (info->local >> 16) & 0xff;
-    local->default_addr = (info->local >> 24) & 0xffff;
+    local->flags        = lp & 0xffff;
+    local->cent         = (lp >> 16) & 0xff;
+    local->default_addr = (lp >> 24) & 0xffff;
     local->def          = (local->flags & FLAG_ZERO_DEFAULT) ? 0x00 : 0xff;
-    nvr->irq            = (info->local >> 40) & 0xff;
+    nvr->irq            = (lp >> 40) & 0xff;
 
     if (nvr->irq == 0x7f)
         nvr->irq = -1;
